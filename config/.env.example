# OBSIDIOS configuration template.
#
#   cp config/.env.example .env
#
# Everything here is optional except OBSIDIOS_SECRET, which the dashboard
# requires in production (OBSIDIOS_ENV=production). Never commit the real .env.

# ── Deployment ──────────────────────────────────────────────────────────────
OBSIDIOS_ENV=dev                    # set to "production" to enforce secret checks

# 32+ random characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
OBSIDIOS_SECRET=

# ── Dashboard credentials ───────────────────────────────────────────────────
# The defaults below are for local development only; change them before
# exposing the dashboard to a network.
DASHBOARD_USER=admin
DASHBOARD_PASS=obsidios123

# Optional read-only account. Viewer sessions can inspect everything but
# cannot acknowledge alerts, deploy rules, block hosts or change config.
VIEWER_USER=
VIEWER_PASS=

# Bind address. 127.0.0.1 keeps the dashboard off the network; put a reverse
# proxy in front of it if operators need remote access.
OBSIDIOS_DASH_HOST=127.0.0.1
OBSIDIOS_DASH_PORT=8080
# Never enable debug on a dashboard that is reachable by anyone else.
OBSIDIOS_DASH_DEBUG=0

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8080

# Prometheus scrape credential. Unset means /metrics returns 401 unless
# OBSIDIOS_METRICS_PUBLIC=1 (do not make it public on an untrusted network).
OBSIDIOS_METRICS_TOKEN=
OBSIDIOS_METRICS_PUBLIC=0

# ── Packet capture / network ────────────────────────────────────────────────
# Interface Suricata and ECHO listen on. With host networking this must be the
# host's real NIC name (eth0, ens18, enp0s31f6, ...).
OBSIDIOS_CAPTURE_IFACE=eth0
# Default gateway. Also protected from SHIELD blocks.
OBSIDIOS_GATEWAY=192.168.1.1

# ── Scanning ────────────────────────────────────────────────────────────────
# Initial scan scope, used until a target is set in the dashboard.
OBSIDIOS_TARGET=192.168.1.0/24
OBSIDIOS_SCAN_PROFILE=FAST          # FAST | STEALTH | GHOST
OBSIDIOS_SCAN_INTERVAL=3600         # seconds between scheduled scans

# Refuse to scan networks that are not private/reserved, and refuse anything
# wider than a /16. Only relax these if you are authorised to test the target.
OBSIDIOS_ALLOW_PUBLIC_SCAN=0
OBSIDIOS_ALLOW_BROAD_SCAN=0

# Host liveness grace periods (seconds). FAST applies to fast discovery.
OBSIDIOS_OFFLINE_GRACE_SECONDS=
OBSIDIOS_FAST_OFFLINE_GRACE_SECONDS=

# Optional MAC-vendor database (path) and Nuclei timeout (seconds).
OBSIDIOS_MAC_VENDORS=
OBSIDIOS_NUCLEI_TIMEOUT=1800

# ── FORGE → Suricata delivery ───────────────────────────────────────────────
# Where the generated ruleset is written. Defaults to forge/rules/suricata.rules
# inside the repository (the container path is /app/forge/rules/suricata.rules).
# FORGE_RULES_PATH=/app/forge/rules/suricata.rules

# Command run after a successful write so the sensor loads the new ruleset.
# Without it, rules are written but Suricata keeps the old set, and the
# dashboard reports "WRITTEN — NO RELOAD CONFIGURED" rather than "DEPLOYED".
#
# Docker Compose shares /var/run/suricata between the daemon and sentinel
# containers, so this works out of the box there. If Suricata runs on the
# host instead, point the command at that socket. Leave empty to disable.
FORGE_RELOAD_CMD=suricatasc -c reload-rules /var/run/suricata/suricata-command.socket

# ── Alerting ────────────────────────────────────────────────────────────────
OBSIDIOS_DISCORD_WEBHOOK=
OBSIDIOS_TELEGRAM_TOKEN=
OBSIDIOS_TELEGRAM_CHAT=

# ── Enrichment / AI (all optional) ──────────────────────────────────────────
NVIDIA_API_KEY=                     # primary model provider (free tier)
OPENROUTER_API_KEY=                 # OpenAI-compatible provider (alias of OPENAI_API_KEY)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                     # wins over OPENROUTER_API_KEY when both are set
# How much scan history ORACLE will analyse. A daily scan stays analysable at
# the default; lower it if you only trust fresh data.
OBSIDIOS_AI_FRESHNESS_HOURS=24
NVD_API_KEY=                        # raises the NVD rate limit from 5 req/30s
SHODAN_API_KEY=
HIBP_API_KEY=

# ── SHIELD (containment) ────────────────────────────────────────────────────
# 1 = log intended actions without touching iptables. Keep it on until the
# allowlist below is correct, then set to 0.
SHIELD_DRY_RUN=1
# Comma-separated IPs/CIDRs that SHIELD must never block.
SHIELD_ALLOWLIST=
# Hard cap on enforced blocks per hour (prevents a block storm).
SHIELD_MAX_ACTIONS_PER_HOUR=10
# Override only if iptables is not on PATH (legacy iptables-nft etc.).
IPTABLES_BIN=iptables

# ── Threat intel (optional) ─────────────────────────────────────────────────
# Path to an operator-supplied blocklist/feed file.
OBSIDIOS_THREAT_FEED_FILE=
# 1 = include demo intel; never enable in production.
OBSIDIOS_THREAT_INTEL_DEMO=0

# ── Wireless ────────────────────────────────────────────────────────────────
OBSIDIOS_WIRELESS=1
# OBSIDIOS_WLAN_IFACE=wlan0

# ── Advanced ────────────────────────────────────────────────────────────────
# Fail fast instead of warning when a runtime directory cannot be created.
# Leave unset for containers with intentionally read-only mounts.
# OBSIDIOS_STRICT_DIRS=1

# ── Metasploit RPC (optional) ───────────────────────────────────────────────
MSF_HOST=127.0.0.1
MSF_PORT=55553
MSF_SSL=0
MSF_PASSWORD=
