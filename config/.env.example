# ── Deployment mode: dev | production (production enforces secret + target guardrails)
OBSIDIOS_ENV=dev

# Target network — MUST be company-owned private CIDR. Public ranges need OBSIDIOS_ALLOW_PUBLIC_SCAN=1
OBSIDIOS_TARGET=192.168.1.0/24
OBSIDIOS_ALLOW_PUBLIC_SCAN=0

# Scan cycle interval in seconds
OBSIDIOS_SCAN_INTERVAL=3600

# NVD API key (optional but recommended: 5 req/30s without, 50 req/30s with)
# Get one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── Secrets (generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))')
# Minimum 32 chars in production. Do NOT commit real .env.
OBSIDIOS_SECRET=change-me-to-48-random-chars-min-32
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-immediately
CORS_ORIGINS=http://localhost:8080

# ── SHIELD safety (company infra: keep DRY_RUN=1 until allowlist verified)
SHIELD_DRY_RUN=1
SHIELD_ALLOWLIST=192.168.1.1,192.168.1.2
SHIELD_AUTO_QUARANTINE=0
SHIELD_MAX_ACTIONS_PER_HOUR=10
OBSIDIOS_GATEWAY=192.168.1.1

# AI API keys (at least one recommended for AI narratives)
# Primary: NVIDIA meta/llama-3.1-8b-instruct | Fallback: OpenRouter | Last: Anthropic
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
GROQ_API_KEY=

# Alert integrations (optional)
OBSIDIOS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# OSINT API keys (optional)
SHODAN_API_KEY=
HIBP_API_KEY=

# Metasploit RPC (optional, for exploit validation)
MSF_HOST=127.0.0.1
MSF_PORT=55553
MSF_PASSWORD=msfrpc